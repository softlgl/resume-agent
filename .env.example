# 本地 MySQL 连接串（你的环境为非默认端口/账号，请按实际填写）
# 格式: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# 示例（默认 3306）: mysql://root:123456@localhost:3306/resume_agent
# 示例（非默认 3307）: mysql://resume_user:resume_pass@127.0.0.1:3307/resume_agent
DATABASE_URL="mysql://root:your_password@localhost:3306/resume_agent"

# JWT 签名密钥（请改成随机长字符串）
JWT_SECRET="change_me_to_a_long_random_secret_string"

# 后端服务端口
PORT=4000

# 前端开发服务器地址（CORS 用）
CLIENT_ORIGIN="http://localhost:5173"
