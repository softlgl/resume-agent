# 本地 MySQL 连接串（你的环境为非默认端口/账号，请按实际填写）
# 格式: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# 示例（默认 3306）: mysql://root:123456@localhost:3306/resume_agent
# 示例（非默认 3307）: mysql://resume_user:resume_pass@127.0.0.1:3307/resume_agent
DATABASE_URL="mysql://root:your_password@localhost:3306/resume_agent"

# JWT 签名密钥（请改成随机长字符串）
JWT_SECRET="change_me_to_a_long_random_secret_string"

# 后端服务端口
PORT=4000

# 前端开发服务器地址（CORS 用）
CLIENT_ORIGIN="http://localhost:5173"

# ---- AI 分析功能（可选，未配置则仅使用本地硬规则检查） ----
# LLM 供应商：deepseek | openai | doubao | qwen | ollama | lmstudio | vllm
LLM_PROVIDER="deepseek"
# API Key（本地模型 ollama/lmstudio/vllm 不需要，云端必填）
LLM_API_KEY=""
# 自定义 base URL（留空则使用各供应商默认值）
# LLM_BASE_URL=""
# 自定义 model（留空则使用各供应商推荐值）
# LLM_MODEL=""

# --- 本地模型快速参考 ---
# Ollama:        LLM_PROVIDER=ollama   LLM_MODEL=qwen2.5:7b      (默认 http://localhost:11434/v1)
# LM Studio:     LLM_PROVIDER=lmstudio LLM_MODEL=qwen2.5-7b      (默认 http://localhost:1234/v1)
# vLLM:          LLM_PROVIDER=vllm     LLM_MODEL=qwen2.5-7b      (默认 http://localhost:8000/v1)
